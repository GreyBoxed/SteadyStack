[Unit]
# The environment lives in tmpfs; this unit puts it back after a reboot.
Requires=steadystack-env.service
After=steadystack-env.service
Description=steadystack: one placing round of the daily buy
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=steadystack
Group=steadystack
WorkingDirectory=/opt/steadystack
# The order lock lives here (ORDER_LOCK_PATH): one file every unit sees,
# writable by the service user, kept across restarts.
StateDirectory=steadystack
EnvironmentFile=/run/steadystack/env

# M24's two guards are both inside the command: the order lock
# (ORDER_LOCK_PATH, non-blocking -- a round that queued behind the close would
# place into a day that has already closed) and the unique constraint on
# (trading_date, task, stream, tick_no). No flock wrapper here: it would hold
# the same file the command then asks for, and every round would be "Busy".
# A rebalance sale's round first: it takes at most one order, and the buy's
# own count of the rate window then leaves it the rest. The leading "-" keeps
# a failed sell round from stopping the buy round after it.
ExecStart=-/opt/steadystack/.venv/bin/python manage.py rebalance_tick
ExecStart=/opt/steadystack/.venv/bin/python manage.py ladder_tick

StandardOutput=append:/var/log/steadystack/ladder.log
StandardError=append:/var/log/steadystack/ladder.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/steadystack /run/steadystack
