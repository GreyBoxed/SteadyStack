[Unit]
# The environment lives in tmpfs; this unit puts it back after a reboot.
Requires=steadystack-env.service
After=steadystack-env.service
Description=steadystack: check the Kite session before the day plans anything
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=steadystack
Group=steadystack
WorkingDirectory=/opt/steadystack
EnvironmentFile=/run/steadystack/env

# A read that touches no order, so it takes no lock.
ExecStart=/opt/steadystack/.venv/bin/python manage.py check_kite_session

StandardOutput=append:/var/log/steadystack/session.log
StandardError=append:/var/log/steadystack/session.log

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/steadystack /run/steadystack
