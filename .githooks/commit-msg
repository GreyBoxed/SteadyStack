#!/bin/sh
# Validate commit messages against Conventional Commits v1.0.0.
# Bypass (use sparingly): git commit --no-verify

msg_file="$1"

# Strip comment lines, then take the subject (first non-empty line).
subject=$(grep -v '^#' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# Merge, revert and fixup/squash commits are generated by git itself.
case "$subject" in
    "Merge "*|"Revert "*|"fixup!"*|"squash!"*|"amend!"*)
        exit 0
        ;;
esac

fail() {
    printf '\n\033[31mCommit rejected:\033[0m %s\n\n' "$1" >&2
    printf 'Your subject:\n  %s\n\n' "$subject" >&2
    cat >&2 <<'USAGE'
Expected Conventional Commits v1.0.0 format:

  <type>[(scope)][!]: <description>

Types:
  feat      a new capability
  fix       a bug fix
  refactor  behaviour-preserving restructure
  perf      a performance improvement
  test      tests only
  docs      documentation only
  build     build system or dependencies
  ci        CI configuration
  chore     tooling, housekeeping
  revert    reverts a previous commit

Rules:
  - description starts lowercase, no trailing period
  - subject is 72 characters or fewer
  - use ! before the colon for a breaking change

Examples:
  feat(engine): rank holdings by underweight gap
  fix(orders): stop ladder repricing a filled order
  refactor(kite): extract postback signature check
USAGE
    exit 1
}

[ -n "$subject" ] || fail "the commit message is empty."

echo "$subject" | grep -Eq '^(feat|fix|refactor|test|docs|chore|perf|ci|build|revert)(\([a-z0-9._/-]+\))?!?: .+' \
    || fail "subject does not match the Conventional Commits format."

description=${subject#*: }

echo "$description" | grep -Eq '^[A-Z][a-z]' \
    && fail "description should start lowercase (write 'add x', not 'Add x')."

echo "$description" | grep -Eq '\.$' \
    && fail "description should not end with a period."

echo "$subject" | grep -Eiq '^(wip|temp|tmp)\b|: *(wip|tmp)\b' \
    && fail "WIP commits do not belong in history — finish the change or stash it."

if [ "${#subject}" -gt 72 ]; then
    fail "subject is ${#subject} characters; keep it to 72 or fewer."
fi

exit 0
