# Copy to .env for local development. .env is gitignored and must never be
# committed; in production these come from AWS Secrets Manager behind the same
# interface (Phase 4).

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=dev-only-changeme-generate-a-real-one-for-any-shared-host
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Runtime connection: restricted role, no UPDATE/DELETE on append-only tables.
DATABASE_URL=postgres://steadystack_app:steadystack_app_dev@localhost:5432/steadystack
# Migration connection: schema owner. Only `manage.py migrate` (and seed_demo)
# use it; left out, there is no "migration" alias at all.
DATABASE_MIGRATION_URL=postgres://steadystack_owner:steadystack_owner_dev@localhost:5432/steadystack

KITE_API_KEY=
KITE_API_SECRET=
# Fernet key encrypting the daily access token at rest. Without it no session
# can be stored -- deliberately, rather than falling back to plaintext.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KITE_TOKEN_KEY=
# Your Zerodha client ID (e.g. AB1234). The Kite login refuses a session for
# any other account. Required in production; left empty here, the check is
# skipped with a warning.
KITE_USER_ID=
